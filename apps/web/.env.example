# Backend origin INCLUDING its /api/v2 prefix. Read docs/backend-integration.md.
# Keep unset until an AIC 2.0 backend is available. No mock fallback exists.
# AIC_BACKEND_URL=http://127.0.0.1:8000/api/v2
# Set to the exact public frontend origin when hosted behind a reverse proxy.
# AIC_FRONTEND_ORIGIN=https://aic.example.com
