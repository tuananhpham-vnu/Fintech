# PostgreSQL-backed default entry (no RAM fallback)
AIC_RUNTIME_MODE=foundation
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://aic_runtime:CHANGE_ME@127.0.0.1:5432/aic
AIC_FRONTEND_ORIGIN=http://127.0.0.1:3000
AIC_COOKIE_NAME=aic_fe_qa

# Temporary owner-approved technical settings; configurable, not final policy.
AIC_SESSION_TTL_MS=28800000
AIC_SESSION_IDLE_MS=1800000
AIC_LOGIN_MAX_FAILURES=5
AIC_LOGIN_WINDOW_MS=900000
AIC_LOGIN_BLOCK_MS=900000

# Owner-approved sandbox replay window. No automatic key reuse/purge.
# This is not an approved production retention policy.
AIC_IDEMPOTENCY_TTL_MS=86400000

# Explicit local MVP opt-in. Omit these variables for foundation-only runtime.
# AIC_DOCUMENT_RUNTIME=local
# AIC_DOCUMENT_AI_MODE=live
# AIC_STORAGE_DIR=C:/private/aic-mvp-cache
# AIC_AI_SERVICE_URL=http://127.0.0.1:8100
# INTERNAL_API_KEY=CHANGE_ME
# Matching AI process: AI_MODE=live, AI_STORAGE_DIR=<same private cache root>.
# Finite development capability limits, not final production policy.
# AIC_INVITATION_TTL_MS=3600000
# AIC_RESPONDENT_REQUESTS_PER_MINUTE=120
# Disable automatic retries only to exercise deliberate manual recovery.
# AIC_WORKER_AUTOMATIC_RETRY=false

# Prototype only: NODE_ENV=test + AIC_RUNTIME_MODE=prototype + explicit enable.
# AIC_ENABLE_PROTOTYPE=true
# AIC_STORAGE_DIR=../../storage
# AIC_AI_SERVICE_URL=http://127.0.0.1:8100
# INTERNAL_API_KEY=TEST_ONLY_NOT_PRODUCTION
