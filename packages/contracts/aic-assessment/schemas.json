{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aic-assessment/1.0.0",
  "definitions": {
    "Readiness": {
      "type": "object",
      "properties": {
        "case_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "document_review_allowed": {
          "type": "boolean"
        },
        "numeric_assessment_allowed": {
          "type": "boolean"
        },
        "method_status": {
          "enum": [
            "unconfigured",
            "configured_pilot",
            "validation_pending",
            "validated_for_limited_use",
            "retired"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waivable_requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "requirement_key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "issue_id": {
                "type": "string",
                "format": "uuid"
              }
            },
            "required": [
              "requirement_key"
            ],
            "additionalProperties": false
          }
        },
        "assessment_allowed": {
          "type": "boolean"
        }
      },
      "required": [
        "case_revision",
        "document_review_allowed",
        "numeric_assessment_allowed",
        "method_status",
        "blockers",
        "limitations",
        "waivable_requirements"
      ],
      "additionalProperties": false
    },
    "FinancialRegistry": {
      "type": "object",
      "properties": {
        "sets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FinancialSetRead"
          }
        },
        "selected_set_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "method_status": {
          "enum": [
            "unconfigured",
            "configured_pilot",
            "validation_pending",
            "validated_for_limited_use",
            "retired"
          ]
        },
        "score": {
          "type": "null"
        },
        "band": {
          "type": "null"
        },
        "grade": {
          "type": "null"
        },
        "pd": {
          "type": "null"
        },
        "metrics": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": [
              "metric_id",
              "group",
              "formula_id",
              "formula",
              "status",
              "raw_ratio",
              "source_facts",
              "max_points",
              "anchors",
              "points",
              "flags",
              "blockers"
            ],
            "properties": {
              "points": {
                "type": "null"
              },
              "status": {
                "enum": [
                  "available",
                  "unavailable"
                ]
              }
            }
          }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weaknesses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "sets",
        "selected_set_id",
        "method_status",
        "score",
        "band",
        "grade",
        "pd",
        "metrics",
        "blockers",
        "strengths",
        "weaknesses",
        "limitations"
      ],
      "additionalProperties": false
    },
    "Case": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "organization_id": {
          "type": "string",
          "format": "uuid"
        },
        "counterparty_id": {
          "type": "string",
          "format": "uuid"
        },
        "exposure_kind": {
          "enum": [
            "RECEIVABLE",
            "PREPAYMENT",
            "LOAN",
            "DEBT_INVESTMENT"
          ]
        },
        "lifecycle_stage": {
          "enum": [
            "proposed",
            "active"
          ]
        },
        "exposure": {
          "$ref": "#/definitions/ExposureRead"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "policy_version": {
          "type": "string"
        },
        "method_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Document"
          }
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Job"
          }
        },
        "questionnaires": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Questionnaire"
          }
        },
        "issue_history": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Finding"
          }
        },
        "review_stale": {
          "type": "boolean"
        },
        "counterparty_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "latest_review_run_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Finding"
          }
        },
        "readiness": {
          "$ref": "#/definitions/Readiness"
        },
        "requests": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DocumentRequest"
          }
        },
        "waivers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Waiver"
          }
        },
        "transaction_review": {
          "anyOf": [
            {
              "$ref": "#/definitions/TransactionReview"
            },
            {
              "type": "null"
            }
          ]
        },
        "policy_artifact_hash": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "latest_assessment_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/definitions/Assessment"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "organization_id",
        "counterparty_id",
        "exposure_kind",
        "lifecycle_stage",
        "exposure",
        "revision",
        "policy_version",
        "method_version",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "Assessment": {
      "oneOf": [
        {
          "$ref": "#/definitions/TransactionAssessment"
        },
        {
          "$ref": "#/definitions/CompanyHealthAssessmentV1"
        }
      ]
    },
    "AssessmentInput": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "financial_set_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "AssessmentAcknowledgementInput": {
      "type": "object",
      "properties": {
        "expected_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000,
          "pattern": ".*[^ ].*"
        }
      },
      "required": [
        "expected_revision",
        "reason"
      ],
      "additionalProperties": false
    },
    "ReviewRun": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "case_id": {
          "type": "string",
          "format": "uuid"
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rules_version": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "snapshot_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_snapshot_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "state": {
          "const": "completed"
        },
        "stale": {
          "type": "boolean"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Finding"
          }
        },
        "issue_history": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Finding"
          }
        },
        "transaction_review": {
          "$ref": "#/definitions/TransactionReview"
        },
        "financial_health": {
          "type": "object",
          "properties": {
            "status": {
              "const": "unconfigured"
            },
            "score": {
              "type": "null"
            },
            "band": {
              "type": "null"
            },
            "grade": {
              "type": "null"
            },
            "pd": {
              "type": "null"
            },
            "blockers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "status",
            "score",
            "band",
            "grade",
            "pd",
            "blockers"
          ],
          "additionalProperties": false
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "counterparty_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "checked_case_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "case_id",
        "case_revision",
        "rules_version",
        "policy_version",
        "snapshot_hash",
        "state",
        "stale",
        "findings",
        "transaction_review",
        "financial_health",
        "created_at"
      ],
      "additionalProperties": false
    },
    "AssessmentPage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items",
        "next_cursor"
      ],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "case_revision",
              "created_at",
              "method_version",
              "state"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "case_revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "method_version": {
                "type": "string"
              },
              "state": {
                "const": "completed"
              }
            }
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[1-9][0-9]*$"
        }
      }
    },
    "FinancialTrendsV1": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "AIC-FINANCIAL-TRENDS-1"
        },
        "case_revision": {
          "type": "integer",
          "minimum": 1
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "baseline_set_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "set": {
                "$ref": "#/definitions/FinancialSetRead"
              },
              "comparison_issues": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "gap_before": {
                "type": "boolean"
              },
              "facts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string"
                    },
                    "value": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "fact_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "uuid"
                    },
                    "fact_revision": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "status": {
                      "enum": [
                        "verified",
                        "missing",
                        "stale",
                        "unverified",
                        "rejected"
                      ]
                    }
                  },
                  "required": [
                    "key",
                    "value",
                    "fact_id",
                    "fact_revision",
                    "status"
                  ],
                  "additionalProperties": false
                }
              },
              "metrics": {
                "type": "array",
                "maxItems": 7,
                "items": {
                  "type": "object",
                  "required": [
                    "metric_id",
                    "group",
                    "formula_id",
                    "formula",
                    "status",
                    "raw_ratio",
                    "source_facts",
                    "max_points",
                    "anchors",
                    "points",
                    "flags",
                    "blockers"
                  ],
                  "properties": {
                    "points": {
                      "type": "null"
                    },
                    "status": {
                      "enum": [
                        "available",
                        "unavailable"
                      ]
                    }
                  }
                }
              }
            },
            "required": [
              "set",
              "comparison_issues",
              "gap_before",
              "facts",
              "metrics"
            ],
            "additionalProperties": false
          }
        },
        "baseline_metrics": {
          "type": "array",
          "maxItems": 7,
          "items": {
            "type": "object",
            "required": [
              "metric_id",
              "group",
              "formula_id",
              "formula",
              "status",
              "raw_ratio",
              "source_facts",
              "max_points",
              "anchors",
              "points",
              "flags",
              "blockers"
            ],
            "properties": {
              "points": {
                "type": "null"
              },
              "status": {
                "enum": [
                  "available",
                  "unavailable"
                ]
              }
            }
          }
        }
      },
      "required": [
        "contract_version",
        "case_revision",
        "captured_at",
        "baseline_set_id",
        "rows",
        "baseline_metrics"
      ],
      "additionalProperties": false
    },
