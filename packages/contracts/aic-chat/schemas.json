{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AIC case assistant contracts",
  "description": "Case-scoped Q&A, search and deterministic analysis. CaseChatInput/CaseChatOutput are internal (backend -> AI service POST /internal/v1/chat); Assistant* are the public /api/v2 shapes. Independent from the frozen 1.0.2 bundle.",
  "version": "aic-chat-0.1",
  "definitions": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ChatTurn": {
      "type": "object",
      "properties": {
        "role": { "enum": ["user", "assistant"] },
        "content": { "type": "string", "minLength": 1, "maxLength": 4000 }
      },
      "required": ["role", "content"],
      "additionalProperties": false
    },
    "AssistantQuestionInput": {
      "type": "object",
      "properties": {
        "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "history": { "type": "array", "maxItems": 8, "items": { "$ref": "#/definitions/ChatTurn" } }
      },
      "required": ["question", "history"],
      "additionalProperties": false
    },
    "ChatPage": {
      "type": "object",
      "properties": {
        "page": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "text": { "type": "string", "maxLength": 40000 },
        "method": { "enum": ["text", "ocr"] }
      },
      "required": ["page", "text", "method"],
      "additionalProperties": false
    },
    "ChatField": {
      "type": "object",
      "properties": {
        "field_key": { "type": "string", "minLength": 1, "maxLength": 128 },
        "value": { "type": ["string", "null"], "maxLength": 2000 },
        "quality": { "type": "string", "maxLength": 32 }
      },
      "required": ["field_key", "value", "quality"],
      "additionalProperties": false
    },
    "ChatDocument": {
      "type": "object",
      "properties": {
        "document_id": { "$ref": "#/definitions/Uuid" },
        "name": { "type": "string", "maxLength": 300 },
        "type": { "type": "string", "maxLength": 64 },
        "version": { "type": "integer", "minimum": 1 },
        "pages": { "type": "array", "maxItems": 10, "items": { "$ref": "#/definitions/ChatPage" } },
        "fields": { "type": "array", "maxItems": 40, "items": { "$ref": "#/definitions/ChatField" } }
      },
      "required": ["document_id", "name", "type", "version", "pages", "fields"],
      "additionalProperties": false
    },
    "ChatFinding": {
      "type": "object",
      "properties": {
        "rule_id": { "type": "string", "maxLength": 32 },
        "severity": { "type": "string", "maxLength": 32 },
        "summary": { "type": "string", "maxLength": 1000 },
        "state": { "type": "string", "maxLength": 32 }
      },
      "required": ["rule_id", "severity", "summary", "state"],
      "additionalProperties": false
    },
    "CaseChatInput": {
      "type": "object",
      "properties": {
        "schema_version": { "const": "aic-chat-0.1" },
        "case_id": { "$ref": "#/definitions/Uuid" },
        "question": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "history": { "type": "array", "maxItems": 8, "items": { "$ref": "#/definitions/ChatTurn" } },
        "documents": { "type": "array", "maxItems": 60, "items": { "$ref": "#/definitions/ChatDocument" } },
        "findings": { "type": "array", "maxItems": 100, "items": { "$ref": "#/definitions/ChatFinding" } }
      },
      "required": ["schema_version", "case_id", "question", "history", "documents", "findings"],
      "additionalProperties": false
    },
    "ChatCitation": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 99 },
        "document_id": { "$ref": "#/definitions/Uuid" },
        "page": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "maxLength": 1000 },
        "verified": { "type": "boolean" }
      },
      "required": ["id", "document_id", "page", "quote", "verified"],
      "additionalProperties": false
    },
    "ChatMetric": {
      "type": "object",
      "properties": {
        "metric_id": { "type": "string", "maxLength": 64 },
        "label": { "type": "string", "maxLength": 200 },
        "value": { "type": ["string", "null"], "maxLength": 64 },
        "unit": { "type": "string", "maxLength": 32 },
        "period": { "type": ["string", "null"], "maxLength": 32 },
        "formula": { "type": "string", "maxLength": 300 },
        "status": { "enum": ["ok", "insufficient_data"] },
        "document_ids": { "type": "array", "maxItems": 60, "items": { "$ref": "#/definitions/Uuid" } }
      },
      "required": ["metric_id", "label", "value", "unit", "period", "formula", "status", "document_ids"],
      "additionalProperties": false
    },
    "ChatDiagnostic": {
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
        "message": { "type": "string", "maxLength": 500 }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "CaseChatOutput": {
      "type": "object",
      "properties": {
        "schema_version": { "const": "aic-chat-0.1" },
        "case_id": { "$ref": "#/definitions/Uuid" },
        "answer": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "citations": { "type": "array", "maxItems": 30, "items": { "$ref": "#/definitions/ChatCitation" } },
        "metrics": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/ChatMetric" } },
        "diagnostics": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/ChatDiagnostic" } },
        "provenance": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["live", "mock"] },
            "model_id": { "type": "string", "maxLength": 128 },
            "prompt_version": { "type": "string", "maxLength": 64 }
          },
          "required": ["mode", "model_id", "prompt_version"],
          "additionalProperties": false
        }
      },
      "required": ["schema_version", "case_id", "answer", "citations", "metrics", "diagnostics", "provenance"],
      "additionalProperties": false
    },
    "AssistantCitation": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "minimum": 1, "maximum": 99 },
        "document_id": { "$ref": "#/definitions/Uuid" },
        "document_name": { "type": "string", "maxLength": 300 },
        "document_version": { "type": "integer", "minimum": 1 },
        "source_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "page": { "type": "integer", "minimum": 1 },
        "quote": { "type": "string", "maxLength": 1000 },
        "verified": { "type": "boolean" }
      },
      "required": ["id", "document_id", "document_name", "document_version", "source_hash", "page", "quote", "verified"],
      "additionalProperties": false
    },
    "AssistantAnswer": {
      "type": "object",
      "properties": {
        "case_id": { "$ref": "#/definitions/Uuid" },
        "answer": { "type": "string", "minLength": 1, "maxLength": 8000 },
        "citations": { "type": "array", "maxItems": 30, "items": { "$ref": "#/definitions/AssistantCitation" } },
        "metrics": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/ChatMetric" } },
        "diagnostics": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/ChatDiagnostic" } },
        "documents_considered": { "type": "integer", "minimum": 0 },
        "mode": { "enum": ["live", "mock"] }
      },
      "required": ["case_id", "answer", "citations", "metrics", "diagnostics", "documents_considered", "mode"],
      "additionalProperties": false
    },
    "AssistantSearchHit": {
      "type": "object",
      "properties": {
        "document_id": { "$ref": "#/definitions/Uuid" },
        "document_name": { "type": "string", "maxLength": 300 },
        "document_type": { "type": "string", "maxLength": 64 },
        "page": { "type": "integer", "minimum": 1 },
        "snippet": { "type": "string", "maxLength": 400 },
        "match_start": { "type": "integer", "minimum": 0 },
        "match_length": { "type": "integer", "minimum": 1 }
      },
      "required": ["document_id", "document_name", "document_type", "page", "snippet", "match_start", "match_length"],
      "additionalProperties": false
    },
    "AssistantSearchResult": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "maxLength": 200 },
        "hits": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/AssistantSearchHit" } },
        "truncated": { "type": "boolean" }
      },
      "required": ["query", "hits", "truncated"],
      "additionalProperties": false
    }
  }
}
