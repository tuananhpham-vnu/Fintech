              "current_liabilities",
              "cash",
              "unrestricted_short_term_equivalents",
              "trade_receivables",
              "total_equity",
              "total_assets",
              "total_liabilities",
              "interest_bearing_debt",
              "operating_profit",
              "depreciation_amortization",
              "interest_expense",
              "net_revenue",
              "cash_from_operations",
              "eligible_cash_and_equivalents"
