{
  "$defs": {
    "AbsenceBasis": {
      "additionalProperties": false,
      "properties": {
        "checklist_version": {
          "title": "Checklist Version",
          "type": "string"
        },
        "inventory_snapshot": {
          "title": "Inventory Snapshot",
          "type": "string"
        },
        "checked_document_version_ids": {
          "items": {
            "type": "string"
          },
          "title": "Checked Document Version Ids",
          "type": "array"
        }
      },
      "required": [
        "checklist_version",
        "inventory_snapshot"
      ],
      "title": "AbsenceBasis",
      "type": "object"
    },
    "DocType": {
      "enum": [
        "registration",
        "loan_request",
        "financial_statement",
        "contract",
        "invoice",
        "acceptance_record",
        "payment_record",
        "other"
      ],
      "title": "DocType",
      "type": "string"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "issue_key": {
          "title": "Issue Key",
          "type": "string"
        },
        "priority": {
          "$ref": "#/$defs/Priority"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "default": "",
          "title": "Description",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "absence_basis": {
          "anyOf": [
            {
              "$ref": "#/$defs/AbsenceBasis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "suggested_request": {
          "anyOf": [
            {
              "$ref": "#/$defs/SuggestedRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "possible_related": {
          "items": {
            "type": "string"
          },
          "title": "Possible Related",
          "type": "array"
        }
      },
      "required": [
        "issue_key",
        "priority",
        "title"
      ],
      "title": "Finding",
      "type": "object"
    },
    "InputIssue": {
      "additionalProperties": false,
      "properties": {
        "object_type": {
          "title": "Object Type",
          "type": "string"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        }
      },
      "required": [
        "object_type",
        "object_id",
        "code"
      ],
      "title": "InputIssue",
      "type": "object"
    },
    "Priority": {
      "description": "Mức ưu tiên xem xét, không phải mức rủi ro tín dụng.",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Priority",
      "type": "string"
    },
    "ProposalStatus": {
      "enum": [
        "candidate_resolved",
        "still_open"
      ],
      "title": "ProposalStatus",
      "type": "string"
    },
    "Resolution": {
      "additionalProperties": false,
      "description": "Đề xuất của hệ thống cho một request item; reviewer mới là người đóng.",
      "properties": {
        "request_item_id": {
          "title": "Request Item Id",
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/ProposalStatus"
        },
        "related_issue_keys": {
          "items": {
            "type": "string"
          },
          "title": "Related Issue Keys",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "required": [
        "request_item_id",
        "proposal"
      ],
      "title": "Resolution",
      "type": "object"
    },
    "RuleResult": {
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_version": {
          "title": "Rule Version",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/RuleStatus"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "subject": {
          "default": "case",
          "title": "Subject",
          "type": "string"
        },
        "operands": {
          "additionalProperties": true,
          "title": "Operands",
          "type": "object"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "finding": {
          "anyOf": [
            {
              "$ref": "#/$defs/Finding"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/Resolution"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "run_id",
        "rule_id",
        "rule_version",
        "status",
        "reason_code",
        "message"
      ],
      "title": "RuleResult",
      "type": "object"
    },
    "RuleStatus": {
      "enum": [
        "pass",
        "issue",
        "unknown",
        "not_applicable"
      ],
      "title": "RuleStatus",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "completed",
        "partial"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "SuggestedRequest": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/DocType"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "contract_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Ref"
        }
      },
      "required": [
        "type",
        "purpose"
      ],
      "title": "SuggestedRequest",
      "type": "object"
    },
    "SuggestedRequestItem": {
      "additionalProperties": false,
      "description": "Một yêu cầu bổ sung đề xuất, gom nhiều finding cùng loại giấy tờ/hợp đồng.",
      "properties": {
        "request_key": {
          "title": "Request Key",
          "type": "string"
        },
        "document_type": {
          "$ref": "#/$defs/DocType"
        },
        "contract_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contract Ref"
        },
        "purposes": {
          "items": {
            "type": "string"
          },
          "title": "Purposes",
          "type": "array"
        },
        "finding_issue_keys": {
          "items": {
            "type": "string"
          },
          "title": "Finding Issue Keys",
          "type": "array"
        }
      },
      "required": [
        "request_key",
        "document_type"
      ],
      "title": "SuggestedRequestItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "snapshot_hash": {
      "title": "Snapshot Hash",
      "type": "string"
    },
    "rule_set_version": {
      "title": "Rule Set Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus"
    },
    "rule_results": {
      "items": {
        "$ref": "#/$defs/RuleResult"
      },
      "title": "Rule Results",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "title": "Findings",
      "type": "array"
    },
    "suggested_requests": {
      "items": {
        "$ref": "#/$defs/SuggestedRequestItem"
      },
      "title": "Suggested Requests",
      "type": "array"
    },
    "resolutions": {
      "items": {
        "$ref": "#/$defs/Resolution"
      },
      "title": "Resolutions",
      "type": "array"
    },
    "input_issues": {
      "items": {
        "$ref": "#/$defs/InputIssue"
      },
      "title": "Input Issues",
      "type": "array"
    },
    "coverage": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "integer"
        },
        "type": "object"
      },
      "title": "Coverage",
      "type": "object"
    }
  },
  "required": [
    "run_id",
    "snapshot_hash",
    "rule_set_version",
    "status"
  ],
  "title": "RunOutput",
  "type": "object"
}
